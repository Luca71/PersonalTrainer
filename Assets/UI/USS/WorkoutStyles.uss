:root {
    --c-bg: rgb(18, 18, 30);
    --c-card: rgb(33, 33, 56);
    --c-accent: rgb(249, 115, 22);
    --c-green: rgb(51, 204, 127);
    --c-orange: rgb(255, 153, 51);
    --c-danger: rgb(204, 51, 51);
    --c-white: rgb(255, 255, 255);
    --c-gray: rgb(140, 140, 166);
    --c-bg-btn: rgb(25, 25, 42);
    --r-btn: 14px;
    --r-card: 16px;
}

.screen-container {
    flex-grow: 1;
    justify-content: space-around;
    background-color: var(--c-bg);
    margin-top: 0;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 10px;
    padding-right: 10px;
}

.screen {
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    background-color: var(--c-bg);
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 32px;
    padding-bottom: 24px;
}

.spacer-sm {
    height: 12px;
}

.spacer-md {
    height: 24px;
}

.spacer-lg {
    height: 40px;
}

.spacer-xl {
    flex-grow: 1;
}

.title-hero {
    font-size: 45px;
    -unity-font-style: bold;
    color: var(--c-accent);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    margin-bottom: 10px;
}

.subtitle {
    font-size: 28px;
    color: var(--c-gray);
    -unity-text-align: middle-center;
    width: 100%;
}

.body-text {
    font-size: 30px;
    color: var(--c-white);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
}

.emoji-hero {
    font-size: 64px;
    -unity-text-align: middle-center;
    width: 100%;
    margin-bottom: 8px;
}

.label-index {
    font-size: 15px;
    color: var(--c-gray);
    -unity-text-align: middle-center;
    width: 100%;
    margin-bottom: 4px;
}

.label-exercise-name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--c-accent);
    -unity-text-align: middle-center;
    white-space: normal;
    width: 100%;
    margin-bottom: 6px;
}

.label-phase {
    font-size: 16px;
    -unity-text-align: middle-center;
    width: 100%;
    margin-bottom: 4px;
}

.phase-prep {
    color: var(--c-orange);
}

.phase-work {
    color: var(--c-green);
}

.timer-block {
    align-items: center;
    width: 100%;
    margin-top: 12px;
    margin-bottom: 12px;
}

.label-timer {
    font-size: 80px;
    -unity-font-style: bold;
    color: var(--c-white);
    -unity-text-align: middle-center;
    width: 100%;
}

.workout-progress {
    width: 88%;
    height: 10px;
    margin-top: 8px;
}

.workout-progress > .unity-progress-bar__background {
    background-color: var(--c-card);
    border-radius: 5px;
    height: 10px;
}

.workout-progress > .unity-progress-bar__progress {
    background-color: var(--c-accent);
    border-radius: 5px;
    height: 10px;
}

.reps-block {
    align-items: center;
    width: 100%;
    margin-top: 16px;
    margin-bottom: 16px;
}

.label-reps {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--c-green);
    -unity-text-align: middle-center;
    width: 100%;
}

.btn {
    border-radius: var(--r-btn);
    border-width: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 88%;
    cursor: link;
    transition-property: scale;
    transition-duration: 0.1s;
}

.btn:hover {
    scale: 1.02 1.02;
}

.btn:active {
    scale: 0.97 0.97;
}

.btn--large {
    height: 100px;
    font-size: 30px;
    margin-bottom: 0;
}

.btn--small {
    height: 70px;
    font-size: 25px;
}

.btn--green {
    background-color: var(--c-green);
    color: rgb(12, 30, 18);
}

.btn--accent {
    background-color: var(--c-accent);
    color: rgb(14, 28, 34);
}

.btn--danger {
    background-color: var(--c-danger);
    color: var(--c-white);
}

.btn--ghost {
    background-color: var(--c-card);
    color: var(--c-gray);
    border-width: 1px;
    border-color: var(--c-gray);
}

.editor-screen {
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    align-items: stretch;
}

.editor-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--c-card);
    padding: 15px 30px;
    height: 150px;
}

.topbar-back {
    width: auto;
    font-size: 26px;
    height: 60px;
}

.topbar-reset {
    width: auto;
    font-size: 26px;
    height: 60px;
}

.topbar-title {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--c-accent);
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.editor-scroll {
    flex-grow: 1;
    background-color: var(--c-bg);
}

.list-container {
    flex-direction: column;
    padding: 12px 16px;
}

.exercise-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--c-card);
    border-radius: var(--r-card);
    padding: 12px 14px;
    margin-bottom: 10px;
}

.row-info {
    flex-direction: column;
    flex-grow: 1;
}

.row-name {
    font-size: 30px;
    color: var(--c-white);
    -unity-font-style: bold;
    white-space: normal;
    max-width: 440px;
}

.row-detail {
    font-size: 26px;
    color: var(--c-gray);
    margin-top: 2px;
}

.row-buttons {
    flex-direction: row;
    align-items: center;
}

.btn-icon {
    width: 72px;
    height: 72px;
    font-size: 30px;
    border-radius: 8px;
    border-width: 0;
    background-color: var(--c-bg-btn);
    color: var(--c-gray);
    margin-left: 4px;
    -unity-text-align: middle-center;
}

.btn-icon--accent {
    color: var(--c-accent);
}

.btn-icon--danger {
    color: var(--c-danger);
}

.editor-add-btn {
    width: 100%;
    border-radius: 0;
    height: 150px;
    font-size: 30px;
}

.form-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background-color: var(--c-card);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    padding: 20px 22px 28px 22px;
    flex-direction: column;
}

.form-title {
    font-size: 25px;
    -unity-font-style: bold;
    color: var(--c-accent);
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.form-label {
    font-size: 20px;
    color: var(--c-gray);
    margin-bottom: 6px;
    margin-top: 15px;
}

.form-field {
    width: 100%;
    height: 50px;
    font-size: 18px;
    color: var(--c-white);
    background-color: var(--c-bg);
    border-radius: 10px;
    border-color: var(--c-gray);
    border-width: 1px;
    padding-left: 10px;
    padding-right: 10px;
}

.form-field > .unity-text-field__input,
.form-field > .unity-base-field__input {
    background-color: var(--c-bg);
    color: var(--c-white);
    border-radius: 10px;
}

.form-row {
    flex-direction: column;
    width: 100%;
}

.slider-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.form-slider {
    flex-grow: 1;
    height: 36px;
}

.form-slider > .unity-base-slider__tracker {
    background-color: var(--c-bg);
}

.form-slider > .unity-base-slider__dragger {
    background-color: var(--c-accent);
}

.form-slider > .unity-base-slider__drag-container > .unity-base-slider__fill {
    background-color: var(--c-accent);
}

.slider-value {
    width: 48px;
    font-size: 15px;
    color: var(--c-white);
    -unity-text-align: middle-right;
    -unity-font-style: bold;
}

.form-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 18px;
}

.form-actions .btn {
    width: auto;
    padding-left: 20px;
    padding-right: 20px;
    margin-left: 10px;
}
